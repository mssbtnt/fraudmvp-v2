# ─── Fraud MVP — Environment Variables ────────────────────────────────────────
# Copy to .env and fill in real values

# Run mode: "true" = demo (no real Telegram API calls)
DEMO_MODE=true

# Logging
LOG_LEVEL=INFO

# ─── Telegram (required for non-demo mode) ────────────────────────────────────
# Get these from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for MVP
DATABASE_URL=sqlite:///./db/fraud_mvp.db

# PostgreSQL for production (uncomment and comment SQLite above)
# DATABASE_URL=postgresql://fraud_mvp:fraud_mvp@localhost:5432/fraud_mvp

# ─── Ollama (Local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-cascade-2:latest

# ─── Alerting ───────────────────────────────────────────────────────────────────
# Telegram bot that sends alerts to your chat
ALERT_BOT_TOKEN=your_alert_bot_token_here
ALERT_CHAT_ID=7684441863

# ─── Scraping ───────────────────────────────────────────────────────────────────
# Playwright browser timeout (ms)
PLAYWRIGHT_TIMEOUT=30000

# Max concurrent scrapers
MAX_CONCURRENT_SCRAPERS=5

# ─── Scoring ────────────────────────────────────────────────────────────────────
ALERT_THRESHOLD=60
