# ─── Fraud MVP — Environment Variables ────────────────────────────────────────
# Copy to .env and fill in real values

# Run mode: "true" = demo (no real Telegram API calls)
DEMO_MODE=true

# Logging
LOG_LEVEL=INFO

# API
API_ACCESS_TOKEN=replace_with_a_long_random_token
CORS_ORIGINS=*

# ─── Telegram (required for non-demo mode) ────────────────────────────────────
# Get these from https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for MVP
DATABASE_URL=sqlite:///./db/fraud_mvp.db

# PostgreSQL for production (uncomment and comment SQLite above)
# DATABASE_URL=postgresql://fraud_mvp:fraud_mvp@localhost:5432/fraud_mvp

# ─── Ollama (Local LLM) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-cascade-2:latest
FRAUD_LLM_ENABLED=false
FRAUD_LLM_TIMEOUT_SECONDS=20
FRAUD_LLM_MAX_FAILURES=2
SEMAKMULE_VERIFY_RECENT_ENTITIES=false
SEMAKMULE_VERIFY_LIMIT=25
SEMAKMULE_MAX_RETRIES=2
SEMAKMULE_HTTP_TIMEOUT_SECONDS=8
SEMAKMULE_CURL_TIMEOUT_SECONDS=8

# ─── Alerting ───────────────────────────────────────────────────────────────────
# Telegram bot that sends alerts to your chat
ALERT_BOT_TOKEN=your_alert_bot_token_here
ALERT_CHAT_ID=your_alert_chat_id_here

# ─── Scraping ───────────────────────────────────────────────────────────────────
# Playwright browser timeout (ms)
PLAYWRIGHT_TIMEOUT=30000

# Optional Reddit research-only scraper credentials
REDDIT_EMAIL=
REDDIT_PASSWORD=

# Max concurrent scrapers
MAX_CONCURRENT_SCRAPERS=5

# ─── Group Search & Monitor ────────────────────────────────────────────────────
# Comma-separated list of group usernames to search/monitor (no @)
WATCH_GROUPS=pelaburan_vip,kerja_parttime_malaysia,scam_report_my
# Comma-separated keywords for group scanning
SCAN_KEYWORDS=scam,penipuan,fraud,menipu,pelaburan,phong

# ─── Scoring ────────────────────────────────────────────────────────────────────
ALERT_THRESHOLD=60
