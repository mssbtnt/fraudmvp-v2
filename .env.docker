# Docker-specific environment overrides
# These override values in .env when running inside Docker

# Redis: use the Docker service name (resolved by Docker DNS)
REDIS_URL=redis://fraud-mvp-redis:6379

# Database: mounted volume, same path inside container
DATABASE_URL=sqlite:///./db/fraud_mvp.db

# Ollama: host machine (not inside container)
OLLAMA_BASE_URL=http://host.docker.internal:11434
